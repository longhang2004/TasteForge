{
  "name": "tasteforge",
  "version": "0.2.0-beta.1",
  "description": "Agent Skill and local CLI for AI coding agents: task-aware UI references, seeded inspiration, design tokens, and static source audits.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20.19"
  },
  "bin": {
    "tasteforge": "./dist/index.js"
  },
  "files": [
    "dist",
    "skills"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/prepare.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@tasteforge/core": "workspace:^",
    "@tasteforge/knowledge": "workspace:^",
    "commander": "^14.0.1",
    "zod": "^4.6.6"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/longhang2004/TasteForge.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/longhang2004/TasteForge#readme",
  "bugs": {
    "url": "https://github.com/longhang2004/TasteForge/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "agent-skills",
    "ai-coding",
    "ui-design",
    "design-intelligence",
    "design-systems",
    "design-tokens",
    "accessibility",
    "cli",
    "typescript",
    "css"
  ]
}

{
  "name": "@tasteforge/core",
  "version": "0.2.0-beta.2",
  "description": "Deterministic UI design ranking, seeded recommendations, Design DNA, CSS token generation, and static source audits for TasteForge.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20.19"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./engine": {
      "types": "./dist/engine.d.ts",
      "import": "./dist/engine.js"
    },
    "./audit": {
      "types": "./dist/audit.d.ts",
      "import": "./dist/audit.js"
    },
    "./references": {
      "types": "./dist/references.d.ts",
      "import": "./dist/references.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@tasteforge/knowledge": "workspace:^",
    "postcss": "^8.5.6",
    "postcss-value-parser": "^4.2.0",
    "typescript": "^5.9.3",
    "zod": "^4.6.6"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/longhang2004/TasteForge.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/longhang2004/TasteForge#readme",
  "bugs": {
    "url": "https://github.com/longhang2004/TasteForge/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "design-intelligence",
    "design-tokens",
    "seeded-random",
    "design-systems",
    "static-analysis",
    "accessibility",
    "css",
    "typescript"
  ]
}
